# Local-only configuration. Never enable emulators in a hosted environment.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-wow.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-wow
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-wow.appspot.com
FIREBASE_PROJECT_ID=demo-wow
FIREBASE_STORAGE_BUCKET=demo-wow.appspot.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Set to an origin reachable by participant devices when running a real workshop.
# NEXT_PUBLIC_APP_URL=https://your-approved-host.example

# Maximum lifetime from creation; manual deletion remains primary.
WORKSHOP_RETENTION_HOURS=4
# Production requires a random secret of at least 32 characters.
# CLEANUP_TICKET_SECRET=
# Set only after the documented production privacy review.
# WORKSHOP_PRIVACY_REVIEWED=true
