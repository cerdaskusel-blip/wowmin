{
  "name": "wow-workshop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "emulators": "node scripts/emulators.mjs",
    "seed": "tsx scripts/seed.ts",
    "grant:facilitator": "tsx scripts/grant-facilitator.ts",
    "test:rules": "tsx tests/rules.integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ephemeral": "node --env-file=.env.local --import tsx tests/ephemeral.integration.ts",
    "test:activities": "node --env-file=.env.local --import tsx tests/activities.integration.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
